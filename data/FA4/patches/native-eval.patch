+"""Fixed metadata fields supported by the FA4 callback/tensor contract.
+
+These helpers read explicit public protocol fields; they do not perform dynamic
+attribute lookup or import code. An absent field retains the original default.
+"""
+
+
+def callback_vec_size(callback, default):
+    try:
+        return callback.__vec_size__
+    except AttributeError:
+        return default
+
+
+def callback_fast_sampling(callback, default):
+    try:
+        return callback.use_fast_sampling
+    except AttributeError:
+        return default
+
+
+def aux_tensor_layout(tensor, align_default, leading_default):
+    try:
+        alignment = tensor.__assumed_align__
+    except AttributeError:
+        alignment = align_default
+    try:
+        leading_dim = tensor.__leading_dim__
+    except AttributeError:
+        return alignment, leading_default, False
+    return alignment, leading_dim, True
